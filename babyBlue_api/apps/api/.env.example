# BabyBlue API — environment. Copy to `.env`; never commit real keys.

# Single shared Supabase project (patient app + admin portal + this API).
SUPABASE_URL=https://wyctcephdorvblshadzd.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# SERVER-ONLY. Bypasses Row-Level Security. The API is the ONLY component
# that holds this key — it must never be shipped to any browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated browser origins allowed to call the API (patient + admin apps).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

PORT=8787
